{"id":"fr-l11","type":"lesson","lang":"fr","level":"Starter","day":11,"title":"Health & pharmacy","phrases":[{"ar":"Où est la pharmacie la plus proche ?","roman":"oo ay lah far-mah-SEE lah plü PROSH","en":"Where is the nearest pharmacy?","ur":"قریب ترین فارمیسی کہاں ہے؟","note":"Look for the green cross."},{"ar":"J'ai besoin d'un médecin.","roman":"zhay buh-ZWAN duhn mayd-SAN","en":"I need a doctor.","ur":"مجھے ڈاکٹر چاہیے۔"},{"ar":"J'ai mal à la tête.","roman":"zhay mahl ah lah TET","en":"I have a headache.","ur":"میرے سر میں درد ہے۔"},{"ar":"J'ai de la fièvre.","roman":"zhay duh lah FYEV-ruh","en":"I have a fever.","ur":"مجھے بخار ہے۔"},{"ar":"Je tousse.","roman":"zhuh TOOS","en":"I have a cough.","ur":"مجھے کھانسی ہے۔"},{"ar":"J'ai mal au ventre.","roman":"zhay mahl oh VAHN-truh","en":"My stomach hurts.","ur":"میرے پیٹ میں درد ہے۔"},{"ar":"J'ai rendez-vous à dix heures.","roman":"zhay rahn-day-VOO ah dee ZUHR","en":"I have an appointment at ten.","ur":"دس بجے میری اپوائنٹمنٹ ہے۔"},{"ar":"Combien de fois par jour ?","roman":"kohm-byan duh FWAH par ZHOOR","en":"How many times a day?","ur":"دن میں کتنی بار؟"},{"ar":"Avant ou après le repas ?","roman":"ah-VAHN oo ah-PRAY luh ruh-PAH","en":"Before or after meals?","ur":"کھانے سے پہلے یا بعد میں؟"},{"ar":"Appelez une ambulance !","roman":"ah-play ün ahm-bü-LAHNS","en":"Call an ambulance!","ur":"ایمبولینس بلائیں!","note":"Emergency number in France: 112 (or 15 for medical help)."},{"ar":"Bon rétablissement !","roman":"bohn ray-tah-blees-MAHN","en":"Get well soon!","ur":"اللہ صحت دے!"}]},
{"id":"fr-l12","type":"lesson","lang":"fr","level":"Starter","day":12,"title":"Phone & appointments","phrases":[{"ar":"Allô ?","roman":"ah-LOH","en":"Hello? (on the phone)","ur":"ہیلو؟"},{"ar":"C'est Shakeel à l'appareil.","roman":"say Shakeel ah lah-pah-RAY","en":"This is Shakeel speaking.","ur":"میں شکیل بول رہا ہوں۔"},{"ar":"Qui est à l'appareil ?","roman":"kee ay tah lah-pah-RAY","en":"Who is speaking?","ur":"کون بات کر رہا ہے؟"},{"ar":"Un instant, s'il vous plaît.","roman":"uhn nan-STAHN, seel voo PLAY","en":"One moment, please.","ur":"ایک لمحہ، براہ مہربانی۔"},{"ar":"Je vous entends mal.","roman":"zhuh voo zahn-tahn MAHL","en":"I can't hear you well.","ur":"آپ کی آواز ٹھیک سے نہیں آ رہی۔"},{"ar":"Je vous rappelle plus tard.","roman":"zhuh voo rah-PEL plü TAR","en":"I'll call you back later.","ur":"میں آپ کو بعد میں فون کروں گا۔"},{"ar":"Je vous envoie un message.","roman":"zhuh voo zahn-VWAH uhn may-SAHZH","en":"I'll send you a message.","ur":"میں آپ کو میسج بھیجتا ہوں۔"},{"ar":"Quel est votre numéro ?","roman":"kel ay VOH-truh nü-may-ROH","en":"What is your number?","ur":"آپ کا نمبر کیا ہے؟"},{"ar":"Je voudrais prendre rendez-vous.","roman":"zhuh voo-DRAY PRAHN-druh rahn-day-VOO","en":"I'd like to make an appointment.","ur":"میں اپوائنٹمنٹ لینا چاہتا ہوں۔"},{"ar":"Mardi, ça vous va ?","roman":"mar-DEE, sah voo VAH","en":"Does Tuesday suit you?","ur":"کیا منگل آپ کے لیے ٹھیک ہے؟"},{"ar":"Je suis en réunion.","roman":"zhuh swee zahn ray-ü-NYOHN","en":"I'm in a meeting.","ur":"میں میٹنگ میں ہوں۔"},{"ar":"Bonne journée, au revoir !","roman":"bun zhoor-NAY, oh ruh-VWAHR","en":"Have a nice day, goodbye!","ur":"آپ کا دن اچھا گزرے، خدا حافظ!"}]}
